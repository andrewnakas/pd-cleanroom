+		if (!out) {
+			// tried and failed, fall back to ROM
+			fileSlots[fileNum].source = SRC_ROM;
+		}
 	}
 
 	if (!out) {
@@ -541,8 +551,8 @@ void romdataFileFree(s32 fileNum)
 	}
 
 	if (fileSlots[fileNum].source == SRC_EXTERNAL) {
-		sysMemFree(fileSlots[fileNum].data);
