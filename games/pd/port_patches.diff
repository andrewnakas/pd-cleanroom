diff --git a/port/fast3d/gfx_sdl2.cpp b/port/fast3d/gfx_sdl2.cpp
index f967cb8..e533517 100644
--- a/port/fast3d/gfx_sdl2.cpp
+++ b/port/fast3d/gfx_sdl2.cpp
@@ -4,6 +4,24 @@
 #include <time.h>
 
 #include "platform.h"
+#ifdef __EMSCRIPTEN__
+#include <emscripten.h>
+// yield to the browser until the next animation frame that is at least ~1/60 s after the last one
+EM_ASYNC_JS(void, web_wait_frame, (double min_ms), {
+    const now0 = performance.now();
+    if (!Module.__pdLastFrame) Module.__pdLastFrame = now0;
+    if (Module.__pdResume) Module.pdWorkMs = (Module.pdWorkMs || 0) * 0.95 + (now0 - Module.__pdResume) * 0.05;
+    for (;;) {
+        const t = await new Promise(r => requestAnimationFrame(r));
+        if (t - Module.__pdLastFrame >= min_ms || t - Module.__pdLastFrame < 0) break;
+    }
+    const t1 = performance.now();
+    // keep a steady cadence; resync if we fell far behind
+    Module.__pdLastFrame = (t1 - Module.__pdLastFrame > 50) ? t1 : Module.__pdLastFrame + 1000 / 60;
+    if (Module.onPdFrame) Module.onPdFrame();
+    Module.__pdResume = performance.now();
+});
+#endif
 #include "system.h"
 
 #include "gfx_window_manager_api.h"
@@ -147,6 +165,9 @@ static void gfx_sdl_init(const struct GfxWindowInitSettings *set) {
     // if that doesn't work, try 3.2 core in case we're on mac, 2.1 compat as a last resort
     static u32 glver[][3] = {
         { 0, 0, 0                                    }, // for command line override
+#ifdef __EMSCRIPTEN__
+        { 3, 0, SDL_GL_CONTEXT_PROFILE_ES            }, // WebGL2
+#endif
         { 3, 0, SDL_GL_CONTEXT_PROFILE_COMPATIBILITY }, // 3.0: default, has all the features required
         { 4, 1, SDL_GL_CONTEXT_PROFILE_CORE          }, // 4.1core: macs only have core profile and this is the latest
         { 3, 2, SDL_GL_CONTEXT_PROFILE_CORE          }, // 3.2core: older macs will only have this at best
@@ -354,6 +375,11 @@ static inline void sync_framerate_with_timer(void) {
 }
 
 static void gfx_sdl_swap_buffers_begin(void) {
+#ifdef __EMSCRIPTEN__
+    SDL_GL_SwapWindow(wnd);
+    web_wait_frame(1000.0 / 60.0 - 2.0);
+    return;
+#endif
     if (target_fps) {
         sync_framerate_with_timer();
     }
